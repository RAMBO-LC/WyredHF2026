{
  "name": "shared-brain",
  "version": "1.0.0",
  "description": "Local-first knowledge base and multi-agent pipeline with persistent shared SQLite memory",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sharedbrain": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server/index.js",
    "serve": "tsx src/server/index.ts",
    "dev": "tsx watch src/server/index.ts",
    "cli": "tsx src/cli/index.ts",
    "demo": "tsx src/cli/index.ts demo",
    "accept": "tsx scripts/accept.ts",
    "eval": "tsx eval/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "app:dmg": "bash macos/build-dmg.sh"
  },
  "keywords": [
    "multi-agent",
    "llm",
    "sqlite",
    "shared-memory",
    "orchestrator",
    "ai-agents"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "commander": "^14.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "openai": "^6.49.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
