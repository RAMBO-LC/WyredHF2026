# SharedBrain Configuration

# OpenAI API Key (or OpenAI-compatible provider like Groq, Ollama, OpenRouter, etc.)
# If not provided, SharedBrain runs in intelligent offline/mock mode with realistic multi-agent outputs!
OPENAI_API_KEY=

# Optional: Custom API Base URL (e.g. for Ollama: http://localhost:11434/v1, or OpenRouter, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model to use (gpt-4o, gpt-4o-mini, etc.)
OPENAI_MODEL=gpt-4o

# SQLite database file path (persisted across restarts)
DATABASE_PATH=./data/shared_brain.db

# Force mock LLM even if API key exists (useful for tests and demos)
# USE_MOCK_LLM=false
