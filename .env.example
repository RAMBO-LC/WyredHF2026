# SharedBrain configuration. Every setting is optional.
# Without an API key, answers are extractive quotes from your documents with citations.

# OpenAI or any OpenAI-compatible API (Ollama, LM Studio, OpenRouter, Groq, ...)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Fully local with Ollama:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1

# Google Gemini (used only when no OpenAI key is set)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Storage
DATABASE_PATH=./data/shared_brain.db
# DATA_INCOMING_DIR=./data/incoming
# DATA_PROCESSED_DIR=./data/processed

# Server
# PORT=3000

# Force extractive answers even when a key is set (useful for tests and offline demos)
# USE_MOCK_LLM=false
